# Public URL used by browsers and links in emails.
APP_URL=https://invoice.example.com

# Keep this on 127.0.0.1 when Caddy/Nginx runs in the same container.
# Use the LXC's private IP only when a reverse proxy runs elsewhere.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080

DB_NAME=essential_invoice
DB_USER=essential_invoice
DB_PASSWORD=GENERATE_WITH_DEPLOY_SH_INIT
JWT_SECRET=GENERATE_WITH_DEPLOY_SH_INIT
ENCRYPTION_KEY=GENERATE_WITH_DEPLOY_SH_INIT

EMAIL_POLLING_INTERVAL=600
RECURRING_INVOICE_INTERVAL=86400

# Optional global SMTP for welcome and password-reset emails.
GLOBAL_SMTP_HOST=
GLOBAL_SMTP_PORT=587
GLOBAL_SMTP_USER=
GLOBAL_SMTP_PASSWORD=
GLOBAL_SMTP_SECURE=false
GLOBAL_SMTP_FROM_EMAIL=
GLOBAL_SMTP_FROM_NAME=essentialInvoice
