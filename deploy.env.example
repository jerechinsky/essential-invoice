# Copy this file to deploy.env and adjust it for your Docker host.
# deploy.env is ignored by Git and is not copied to the remote host.
REMOTE_USER=root
REMOTE_HOST=192.168.1.50
REMOTE_PORT=22
REMOTE_DIR=/opt/essential-invoice
COMPOSE_PROJECT=essential-invoice

# These paths are relative to the project root and are synced to the host.
COMPOSE_FILE=docker-compose.yml
APP_ENV_FILE=.env
